{
  "id": "snake-v11",
  "name": "Snake v1.1",
  "pageCandidates": [
    "/games/snake/",
    "/snake/",
    "/games/snake/index.html",
    "/snake/index.html"
  ],
  "fallbackPath": "/assets/qa/webgames/snake-v11-contract.html",
  "requiredHooks": [
    "QA_READY",
    "render_game_to_text",
    "advanceTime",
    "reset"
  ],
  "parsedAssertions": [
    {
      "key": "mode",
      "type": "string",
      "anyOfValues": [
        "classic",
        "timed",
        "wrap"
      ]
    },
    {
      "key": "timeLeft",
      "type": "number"
    },
    {
      "key": "timer",
      "type": "number"
    },
    {
      "key": "wrapWalls",
      "type": "boolean"
    },
    {
      "key": "score",
      "type": "number"
    },
    {
      "key": "length",
      "type": "number"
    },
    {
      "key": "bonusActive",
      "type": "boolean"
    },
    {
      "key": "bonusPoints",
      "type": "number"
    },
    {
      "key": "bonusReadyIn",
      "type": "number"
    },
    {
      "key": "bonusState",
      "type": "string",
      "anyOfValues": [
        "idle",
        "active"
      ]
    },
    {
      "key": "bonus",
      "type": "object"
    },
    {
      "key": "bonusApple",
      "exists": true
    }
  ],
  "bursts": [
    {
      "label": "boot",
      "calls": [
        "window.reset()"
      ]
    },
    {
      "label": "timed-mode",
      "calls": [
        "document.querySelector('[data-snake-mode=\"timed\"]')?.click()"
      ],
      "advanceMs": 360
    },
    {
      "label": "timed-step",
      "keys": [
        "ArrowRight"
      ],
      "advanceMs": 720
    },
    {
      "label": "wrap-mode",
      "calls": [
        "document.querySelector('[data-snake-mode=\"wrap\"]')?.click()"
      ],
      "advanceMs": 360
    },
    {
      "label": "wrap-step",
      "keys": [
        "ArrowRight",
        "ArrowDown"
      ],
      "advanceMs": 360
    },
    {
      "label": "reset",
      "calls": [
        "document.querySelector('[data-snake-mode=\"classic\"]')?.click()"
      ]
    }
  ]
}

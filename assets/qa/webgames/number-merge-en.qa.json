{
  "id": "number-merge-en",
  "name": "Number Merge (English)",
  "pageCandidates": [
    "/en/games/number-merge/",
    "/en/number-merge/",
    "/en/games/number-merge/index.html",
    "/en/number-merge/index.html"
  ],
  "fallbackPath": "/assets/qa/webgames/number-merge-contract.html",
  "requiredHooks": [
    "QA_READY",
    "render_game_to_text",
    "advanceTime",
    "reset"
  ],
  "parsedAssertions": [
    {
      "key": "mode",
      "type": "string",
      "anyOfValues": [
        "free",
        "daily"
      ]
    },
    {
      "key": "phase",
      "type": "string",
      "anyOfValues": [
        "ready",
        "playing",
        "won",
        "stuck"
      ]
    },
    {
      "key": "score",
      "type": "number"
    },
    {
      "key": "moves",
      "type": "number"
    },
    {
      "key": "maxTile",
      "type": "number"
    },
    {
      "key": "dailyBest",
      "type": "number"
    },
    {
      "key": "dailyKey",
      "type": "string"
    },
    {
      "key": "seed",
      "type": "number"
    },
    {
      "key": "board",
      "type": "array"
    }
  ],
  "bursts": [
    {
      "label": "boot",
      "calls": [
        "window.reset()"
      ]
    },
    {
      "label": "daily-mode",
      "calls": [
        "document.getElementById('merge-daily')?.click()"
      ],
      "advanceMs": 360
    },
    {
      "label": "move-right",
      "keys": [
        "ArrowRight"
      ],
      "advanceMs": 360
    },
    {
      "label": "move-down",
      "keys": [
        "ArrowDown"
      ],
      "advanceMs": 360
    },
    {
      "label": "undo",
      "calls": [
        "document.getElementById('merge-undo')?.click()"
      ],
      "advanceMs": 120
    },
    {
      "label": "reset",
      "calls": [
        "window.resetGame(0x2048cafe, { mode: 'free' })"
      ],
      "advanceMs": 360
    }
  ]
}
